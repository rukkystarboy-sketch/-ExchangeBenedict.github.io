        function populateAssetDropdown() {
            const assetSelect = document.getElementById('calc-asset');
            assetSelect.innerHTML = '';

            const source = (currentMode === 'giftcard') ? giftCardData : cryptoData;

            Object.keys(source).forEach(key => {
                const option = document.createElement('option');
                option.value = key;
                option.innerText = source[key].name;
                assetSelect.appendChild(option);
            });

            populateSubtypeDropdown();
        }

        function populateSubtypeDropdown() {
            const assetKey = document.getElementById('calc-asset').value;
            const subtypeSelect = document.getElementById('calc-subtype');
            subtypeSelect.innerHTML = '';

            const source = (currentMode === 'giftcard') ? giftCardData : cryptoData;
            const asset = source[assetKey];

            if (asset && asset.subtypes) {
                Object.keys(asset.subtypes).forEach(subKey => {
                    const sub = asset.subtypes[subKey];
                    const option = document.createElement('option');
                    option.value = subKey;
                    option.innerText = sub.label;
                    subtypeSelect.appendChild(option);
                });
            }

            updateCalc();
        }

        function updateCalc() {
            const assetKey = document.getElementById('calc-asset').value;
            const subKey = document.getElementById('calc-subtype').value;
            const amount = parseFloat(document.getElementById('calc-amount').value) || 0;
            const payoutCurr = document.getElementById('calc-payout-curr').value;

            const source = (currentMode === 'giftcard') ? giftCardData : cryptoData;
            const asset = source[assetKey];
            
            if (!asset || !asset.subtypes[subKey]) return;

            const sub = asset.subtypes[subKey];
            document.getElementById('calc-currency-symbol').innerText = sub.currency;

            let rate = sub.rate;
            let total = amount * rate;

            let formattedTotal = "";
            let formattedRate = "";

            if (payoutCurr === 'NGN') {
                formattedRate = `₦${rate.toLocaleString()} / ${sub.currency}`;
                formattedTotal = `₦${total.toLocaleString(undefined, {maximumFractionDigits: 2})}`;
            } else if (payoutCurr === 'USD') {
                let usdRate = (rate / 1490).toFixed(2);
                let usdTotal = (amount * usdRate).toFixed(2);
                formattedRate = `$${usdRate} / unit`;
                formattedTotal = `$${usdTotal}`;
            } else if (payoutCurr === 'USDT') {
                let usdtTotal = ((amount * rate) / 1495).toFixed(2);
                formattedRate = `1 USDT = ₦1,495`;
                formattedTotal = `${usdtTotal} USDT`;
            }

            document.getElementById('calc-rate-display').innerText = formattedRate;
            document.getElementById('calc-total-payout').innerText = formattedTotal;
        }

